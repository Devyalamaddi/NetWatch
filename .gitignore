# ============================================================
# NetWatch — .gitignore
# ============================================================

# ---- Maven build output ----
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ---- Java compiled classes ----
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---- Application logs ----
logs/
*.log
*.log.gz

# ---- IDE — IntelliJ IDEA ----
.idea/
*.iws
*.iml
*.ipr
out/

# ---- IDE — Eclipse ----
.classpath
.project
.settings/
bin/

# ---- IDE — VS Code ----
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# ---- OS artifacts ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Environment / secrets ----
.env
.env.local
*.env

# ---- Test reports ----
surefire-reports/

# ---- Temporary files ----
*.tmp
*.bak
*.swp
*~
